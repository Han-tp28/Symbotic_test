  <version>0.0.1</version>
  <description>One-command bringup for the differential-drive robot demo.</description>
  <maintainer email="maintainer@example.com">Symbotic Project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>

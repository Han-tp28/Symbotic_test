  <exec_depend>launch_ros</exec_depend>
  <exec_depend>symbotic_control</exec_depend>
  <exec_depend>symbotic_description</exec_depend>
  <exec_depend>symbotic_interfaces</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
